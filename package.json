{
  "name": "canvasnotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A personal visual note-taking app with boards, cards and columns.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test:parity": "node tests/run-parity.mjs",
    "test:accounts": "node tests/run-accounts.mjs",
    "test:security": "node tests/run-security.mjs",
    "test:responsive": "node tests/run-responsive.mjs",
    "test:areas": "node tests/run-areas.mjs",
    "test:move": "node tests/run-move.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "html-to-image": "^1.11.13",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
